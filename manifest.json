{
  "manifest_version": 3,
  "name": "CPI Pulse - Integration Analytics & Health",
  "short_name": "CPI Pulse",
  "version": "1.0.0",
  "description": "Live health monitoring, performance analytics, bottleneck detection, and iFlow overview for SAP Cloud Integration / Integration Suite.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CPI Pulse - Open Dashboard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.hana.ondemand.com/*",
    "*://*.cloud.sap/*",
    "*://*.btp.sap/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.hana.ondemand.com/*",
        "*://*.cloud.sap/*",
        "*://*.btp.sap/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard/*",
        "icons/*"
      ],
      "matches": [
        "*://*.hana.ondemand.com/*",
        "*://*.cloud.sap/*",
        "*://*.btp.sap/*"
      ]
    }
  ]
}
